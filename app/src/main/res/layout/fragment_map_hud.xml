<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/map_fab_logout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/dp_5"
        android:layout_marginTop="@dimen/dp_25"
        android:alpha=".75"
        android:clickable="false"
        android:src="@drawable/ic_logout_20dp"
        app:backgroundTint="@color/white"
        app:elevation="3dp"
        app:fabSize="mini"
        app:maxImageSize="@dimen/dp_15"
        app:tint="@color/grey_900" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/map_fab_report"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_pen_20dp"
        android:layout_marginEnd="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_100"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:clickable="false"
        app:backgroundTint="@color/grey" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/map_fab_search"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_margin="24dp"
        android:text="Search"
        android:textSize="18sp"
        android:textColor="@color/grey_900"
        android:textAlignment="viewStart"
        android:textAllCaps="false"
        android:paddingHorizontal="25dp"
        android:layout_alignParentBottom="true"
        app:backgroundTint="@color/white"
        app:cornerRadius="25dp"
        app:icon="@drawable/ic_magnifying_glass_24dp"
        app:iconGravity="end"
        app:iconTint="@color/grey_900" />
</RelativeLayout>