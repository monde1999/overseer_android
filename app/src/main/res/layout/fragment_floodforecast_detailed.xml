<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/dp_10"
    android:paddingBottom="@dimen/dp_20">
    <ImageButton
        android:id="@+id/forecast_btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_left_20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginLeft="@dimen/dp_20"
        android:background="@color/white"
        android:contentDescription="@string/back_button"
        android:visibility="gone"/>
    <ImageButton
        android:id="@+id/forecast_btn_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_close_20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginRight="@dimen/dp_20"
        android:background="@color/white"
        android:contentDescription="@string/close_button"
        android:visibility="gone"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/forecast_btn_back"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginHorizontal="10dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ic_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_warning_20dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginLeft="@dimen/dp_10"
                android:layout_marginStart="@dimen/dp_10"
                android:contentDescription="@string/warning_icon"/>
            <TextView
                android:id="@+id/forcast_tv_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flood_here"
                android:textColor="@color/black"
                app:layout_constraintLeft_toRightOf="@id/ic_warning"
                app:layout_constraintTop_toTopOf="@id/ic_warning"
                app:layout_constraintBottom_toBottomOf="@id/ic_warning"
                android:textSize="@dimen/sp_16"
                android:layout_marginLeft="@dimen/dp_10"
                android:layout_marginStart="@dimen/dp_10"/>
            <RelativeLayout
                android:id="@+id/iv_forecast_loc_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/ic_warning"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="10dp">

                <ImageView
                    android:id="@+id/forecast_iv_street"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_150"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_street"
                    android:contentDescription="@string/street_snapshot" />

                <ProgressBar
                    android:id="@+id/forecast_pb_street"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:indeterminateTint="@color/white" />
            </RelativeLayout>
            <TextView
                android:id="@+id/forecast_tv_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/street_snapshot"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_14"
                app:layout_constraintTop_toBottomOf="@id/iv_forecast_loc_container"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginTop="@dimen/dp_5"
                android:layout_marginHorizontal="@dimen/dp_10"/>
            <TableLayout
                android:id="@+id/weatherTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/forecast_tv_location"
                android:background="@drawable/bg_weather"
                android:layout_marginTop="@dimen/dp_20"
                android:padding="@dimen/dp_20"
                android:layout_marginHorizontal="@dimen/dp_10">
                <TableRow android:weightSum="2">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_column="0"
                        android:layout_weight="1"
                        android:gravity="left"
                        android:layout_height="match_parent">
                        <TextView
                            android:id="@+id/forecast_tv_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="80dp"
                            android:text="@string/degree_celsius"
                            android:textSize="@dimen/sp_70"
                            android:textColor="@color/white"
                            android:gravity="center"/>
                        <TextView
                            android:id="@+id/forecast_tv_rain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rainfall"
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/white"
                            android:drawablePadding="@dimen/dp_5"
                            android:drawableLeft="@drawable/ic_rain_15dp"
                            tools:ignore="UseCompatTextViewDrawableXml" />
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_column="1"
                        android:layout_weight="1"
                        android:gravity="right">
                        <RelativeLayout
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content">
                            <ImageView
                                android:id="@+id/forecast_iv_weather"
                                android:layout_width="@dimen/dp_80"
                                android:layout_height="@dimen/dp_80"
                                android:layout_centerInParent="true"
                                android:contentDescription="@string/weather_icon"/>
                            <ProgressBar
                                android:id="@+id/forecast_pb_weather"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:indeterminateTint="@color/white"/>
                        </RelativeLayout>
                        <TextView
                            android:id="@+id/forecast_tv_weather_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weather_status"
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/white"/>
                    </LinearLayout>
                </TableRow>

                <TableRow android:weightSum="4" android:layout_marginTop="@dimen/dp_10">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_column="0"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:gravity="center|top">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/morning"
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/white"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_morning_20dp"
                            android:layout_marginTop="@dimen/dp_5"
                            android:contentDescription="@string/morning"/>
                        <TextView
                            android:id="@+id/forecast_tv_morning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/degree_celsius"
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/white"
                            android:layout_marginTop="@dimen/dp_5"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_column="1"
                        android:gravity="center|top"
                        android:layout_width="0dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/afternoon"
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/white"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_afternoon_20dp"
                            android:layout_marginTop="@dimen/dp_5"
                            android:contentDescription="@string/afternoon"/>
                        <TextView
                            android:id="@+id/forecast_tv_afternoon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/degree_celsius"
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/white"
                            android:layout_marginTop="@dimen/dp_5"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_column="2"
                        android:layout_width="0dp"
                        android:gravity="center|top">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/evening"
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/white"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_evening_20dp"
                            android:layout_marginTop="@dimen/dp_5"
                            android:contentDescription="@string/evening"/>
                        <TextView
                            android:id="@+id/forecast_tv_evening"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/degree_celsius"
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/white"
                            android:layout_marginTop="@dimen/dp_5"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_column="4"
                        android:layout_width="0dp"
                        android:gravity="center|top">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/night"
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/white"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_night_20dp"
                            android:layout_marginTop="@dimen/dp_5"
                            android:contentDescription="@string/night"/>
                        <TextView
                            android:id="@+id/forecast_tv_night"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/degree_celsius"
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/white"
                            android:layout_marginTop="@dimen/dp_5"/>
                    </LinearLayout>
                </TableRow>
            </TableLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>